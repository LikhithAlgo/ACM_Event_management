{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node16"
  },
  "include": ["src/**/*", "*.ts"],
  "ts-node": {
    "files": true
  }
}
